---
import '../styles/global.css';
import Header from '../components/Header.astro'
import { showHTML } from '../utils/render.utils';

const {
	alwaysBurger,
	hidePrintTitle,
	pageTitle,
	subHeading,
	printLandscape,
} = Astro.props;

const h1Class = (hidePrintTitle === true)
	? 'hide-print-title'
	: '';

const mainClass = (printLandscape === true)
	? 'landscape'
	: '';
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle} - Evan Wills</title>
	</head>
	<body>
        <Header alwaysBurger={alwaysBurger} />
		<main class={mainClass}>
			<h1 class={h1Class}>{pageTitle}</h1>

			{showHTML(subHeading, <h2>{subHeading}</h2>)}

			<!-- START SLOT: content-intro -->
			<slot name="content-intro" />
			<!--  END SLOT:  content-intro -->

			<!-- START SLOT: default -->
			<slot />
			<!--  END SLOT:  default -->

			<!-- START SLOT: content-conclusion -->
			<slot name="content-conclusion" />
			<!--  END SLOT:  content-conclusion -->
		</main>
	</body>
</html>
