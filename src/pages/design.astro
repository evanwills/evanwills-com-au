---
import '../styles/global.css';
import Header from '../components/Header.astro'

const pageTitle = 'Industrial & Furniture Design';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
        <Header />
		<main>
			<h1>{pageTitle}</h1>
			<h1 class="castellar sample">
				{pageTitle}
				<span>castellar</span>
			</h1>
			<h1 class="felix sample">
				{pageTitle}
				<span>felix</span>
			</h1>
			<h1 class="engravers sample">
				{pageTitle}
				<span>engravers</span>
			</h1>
			<h1 class="palatino sample">
				{pageTitle}
				<span>palatino</span>
			</h1>
			<h1 class="footlight sample">
				{pageTitle}
				<span>footlight</span>
			</h1>
			<h1 class="gigi sample">
				{pageTitle}
				<span>gigi</span>
			</h1>
			<h1 class="harlow sample">
				{pageTitle}
				<span>harlow</span>
			</h1>
			<h1 class="miriam sample">
				{pageTitle}
				<span>miriam</span>
			</h1>
			<h1 class=" kristen sample">
				{pageTitle}
				<span> kristen</span>
			</h1>
			<h1 class="inkfree sample">
				{pageTitle}
				<span>inkfree</span>
			</h1>
		</main>
	</body>
</html>
