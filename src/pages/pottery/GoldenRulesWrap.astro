---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Credits from '../../components/Credit.astro';

const { href, label, pageTitle } = Astro.props;
---

<style type="text/css">
:root {
  --max-base-width: 40rem;
  --pre-width: 5.5rem;
  --post-width: calc(100% - var(--pre-width) - 1rem);
}

h1, h2, h3, h4, h5 {
  font-family: verdana, arial, helvetica, sans-serif;
  font-weight: bold;
  line-height: 1.15em;
}

h1 {
  font-size: 175%;
}

h2 {
  font-size: 125%;
}

ol li {
  list-style-type: none;
  margin-left: 6.6em;
  margin-bottom: 1.5em;
  position: relative;
}
ol ol li {
  list-style-type: lower-alpha;
}

em {
  font-style: italic;
}

strong {
  font-weight: bold;
  color: #555;
}

ul li {
  list-style-type: disc;
  margin-left: 1em;
  padding-left: 1em;
  margin-bottom: 0.25em;
  font-weight: normal;
  position: relative;
}

#copyright {
  display: block;
  margin-top: 2rem;
  font-size: 0.75rem;
  scroll-margin-top: 2rem;
}
#copyright .cc-link {
  float: right;
  padding: 0 0 1rem 1rem;
}
#copyright img {
  width: 10rem;
  height: auto;
}
@media print { #copyright img { width: 6rem; } }

main { clear: both;}

@media print {
  .screen-only {
    display: none;
  }
  a {
    text-decoration: none;
    color: #000;
  }
  a::after {
    font-style: italic;
    color: #ccc;
    content: " [" attr(href) "]";
  }

  a.no-helper:after {
      display: none;
  }
}
.primary {
  counter-reset: rule;
  border-top: 0.2rem solid #ccc;
}

.primary h1 { font-size: 150%; }

/* #throwing {
} */

.rule > *, .hot > *, .reminder > * {
  display: flex;
  flex-direction: row;
  column-gap: 1rem;
}
.rule .pre, .rule ::before,
.hot .pre, .hot ::before,
.reminder .pre, .reminder ::before {
  display: block;
  font-weight: bold;
  text-align: right;
  width: var(--pre-width);
}

.rule .pre + *, .rule .post,
.hot .pre + *, .hot .post,
.reminder .pre + *, .reminder .post {
  max-width: var(--post-width);
}

.rule > *:nth-child(n+2),
.hot > *:nth-child(n+2),
.reminder > *:nth-child(n+2) {
  margin-top: 1rem;
}

.post > h4, .post > h5, .post > h6 {
  font-family: Arial, Helvetica, sans-serif !important;
  font-size: 1rem !important;
  line-height: 1.4rem !important;
}

.post :first-child { margin-top: 0; }
.post :last-child { margin-bottom: 0; }

.sub {
  border-top: 0.1rem solid #555;
  border-bottom: 0.1rem solid #555;
  margin-bottom: 0.2rem;
  padding-top: 1rem;
}
main > section > .sub:last-child {
  border-bottom: none;
}

.sub > header > h1 { font-size: 130%; }
.sub ol {
  margin-left: 0%;
  padding-left: 0%;
}
.sub ol li {
  margin-left: 0%;
  padding-left: 0%;
}
.sub :first-of-type {
    border-top: none;
}

@media screen {
  .primary {
    margin-top: 2rem;
    /* padding-bottom: 9rem; */
  }
  .sub {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .sub:first-of-type {
    padding-top: 1rem;
  }

  #throwing {
    margin-top: 4.5rem;
  }
  #turning {
    margin-top: 0rem;
    padding-top: 3rem;
  }
}

@media print {
  .rule > *:first-child {
    page-break-after: avoid;
  }

  .post, .post p, .post li {
    orphans: 2;
    widows: 2;
  }

  .page-br {
    page-break-before: always;
    border-top: none;
    padding-top: 0%;
  }
  #throwing {
    margin-top: 1.5rem;
  }
  #turning {
    border-top: none;
  }

  .sub {
    padding-top: 1rem;
    padding-bottom: 2rem;
  }
}

article {
  padding-top: 0.5rem;
  padding-bottom: 2rem;
  border-bottom: 0.1rem dashed #ccc;
}
li:last-child > article {
  border-bottom: none;
  padding-bottom: 0;
}
article ol li {
  margin-left: 1rem !important;
  padding-left: 0.5rem !important;
  margin-bottom: 0.5rem;
}
@media print {
}

article .last {
  border-bottom: none;
}

@media print {
  article {
    font-size: 14px;
    padding-top: 0rem;
    padding-bottom: 1rem;
  }
  article ol li {
    /* page-break-inside: avoid; */
  }
  article .last-on-page {
      border-bottom: none;
      page-break-after: always;
  }
}

@media screen and (max-width: 37rem) {
  div {
    margin-left: -6.5rem;
  }
}

.details,
.how,
.note,
.why {
  position: relative;
  margin-top: 0.5rem;
  font-weight: normal;
}
.details:before,
.how:before,
.note:before,
.why:before {
  font-weight: bold;
}

.details:before { content: 'Details:'; }

.how:before { content: 'How?'; }

.why:before { content: 'Why?'; }

.note:before { content: 'Note:'; }

.question {
  /* border: 0.1rem solid #999; */
  padding: 1rem;
  margin: 2rem auto 2rem;
  max-width: 29rem;
  border-radius: 0.25rem;
  box-shadow: 0.5rem 0.5rem 0.5rem rgba(200, 200, 200, 0.4);
  border: 0.05rem solid #eee;
  /* border-left: 0.1rem solid #999; */
}
.question :first-child { margin-top: 0; }
.question :last-child { margin-bottom: 0; }
.question p { margin: 0.5rem 0%; }
.question ol li {
  list-style-type: decimal;
  margin: 0% 0% 0.5rem 1.5rem;
  padding: 0% 0% 0% 0.5rem;
}

@media print {
  .question {
    border-width: 0.1rem;
    border-style: solid;
    border-top-color: #ccc;
    border-right-color: #999;
    border-bottom-color: #999;
    border-left-color: #ccc;
    box-shadow: none;
    margin: 1.5rem 5rem 1.5rem;
  }
}


@media print {
  .sub article header {
    page-break-inside: avoid;
    page-break-after: avoid;
  }
}
.rule h2, .rule h3, .rule h4 {
  font-family: verdana, arial, helvetica, sans-serif;
  font-size: 115%;
}
sub article h3::before {
  font-weight: normal;
  display: block;
  margin-left: -5.7rem;
  margin-bottom: -1.15rem;
}
@media print {
  sub article h1::before {
    /* padding-left: 5.5rem; */
    margin-bottom: -1.0rem;
    /* text-indent: -5.5rem; */
    /* margin-left: -1.7rem; */
  }
}
.sub article h2 {
  font-size: 105%;
}

.rule .before::before {
  content: 'Rule ' counter(rule);
  counter-increment: rule;
}
@media print {
  .rule h1::before {
    /* top: 0.15rem; */
  }
}

.reminder .before::before  {
  content: 'Reminder ';
}

.hot .before::before {
  content: 'Hot tip: ';
}

.note .before::before {
  content: 'Note: ';
}

@page {
  size: 210mm 297mm;
  margin: 1.25cm 1.5cm;

  @top-left {
    padding-left: 1em;
    padding-top: 1em;
    content: "Evan's Golden rules for easier potting";
  }

  @top-right {
    content: "By Evan Wills";
  }

  @bottom-left {
      content: "github.com/evanwills/golden-rules-for-pottery";
  }
}
</style>
<BaseLayout pageTitle={pageTitle}>
	<Credits
		href={href}
		label={label}
		name="Golden rulse for easier throwing and turning"
		repo="golden-rules-for-pottery",
		slot="content-intro"
		year="2025" />

	<slot />
</BaseLayout>